
function setup() {
  createCanvas(600, 600); // Create the canvas
  background(255); // Make the background white

  let spacing = 50; // Space between squares
  let margin = 50; // Space around the grid
  let size = 34; // Square size

  stroke(0); // Make outlines black
  strokeWeight(2); // Set outline thickness

  // Go through each row
  for (let y = margin; y < height - margin; y += spacing) {

    // Go through each column
    for (let x = margin; x < width - margin; x += spacing) {

      let column = (x - margin) / spacing; // Get the column number
      let row = (y - margin) / spacing; // Get the row number

      // Choose a color based on the square's position
      if ((column + row) % 8 == 0) {
        fill(0, 100, 255); // Electric blue
      } else if ((column * 2 + row) % 9 == 0) {
        fill(255, 0, 0); // Red
      } else if ((column + row * 2) % 11 == 0) {
        fill(255, 220, 0); // Yellow
      } else {
        noFill(); // Leave the square white inside
      }

      rect(x, y, size, size); // Draw the square
    }
  }
}
